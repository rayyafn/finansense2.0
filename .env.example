# ========================================================
# FinanSense 2.0 - Arquivo de Exemplo de Variáveis de Ambiente
# COPIE ESTE ARQUIVO PARA .env E AJUSTE CONFORME SEU AMBIENTE LOCAL.
# ATENÇÃO: NUNCA COMMITE O ARQUIVO .env COM DADOS REAIS!
# ========================================================

# 1. Configurações do Servidor Backend Node.js / Express
PORT=3001
NODE_ENV=development

# 2. Conexão com o Banco de Dados Relacional (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finansense_db
DB_USER=root
DB_PASS=

# 3. Chave Secreta para Assinatura dos Tokens JWT (Autenticação Segura)
JWT_SECRET=finansense_jwt_secret_dev_key_exemplo_2026_substituir_em_producao

# 4. URL Base da API para o Frontend Vite (opcional se rodar com proxy interno)
VITE_API_URL=http://localhost:3001/api
